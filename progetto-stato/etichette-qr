<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Etichette QR — Sepack</title>
  <!-- QRCode.js -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <style>
    :root {
      --primary: #00B4CC;
      --dark: #1a252f;
      --surface: #243341;
      --surface2: #2c3e50;
      --text: #ecf0f1;
      --muted: rgba(255,255,255,.5);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', system-ui, sans-serif; background: var(--dark); color: var(--text); min-height: 100vh; }

    .header { display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; background: rgba(0,0,0,.35); border-bottom: 1px solid rgba(255,255,255,.07); }
    .header h1 { font-size: 17px; font-weight: 700; }
    .header a { color: var(--muted); font-size: 13px; text-decoration: none; }

    .container { max-width: 860px; margin: 0 auto; padding: 24px 16px; }

    .card { background: var(--surface); border-radius: 12px; padding: 20px; margin-bottom: 20px; }
    .card h2 { font-size: 15px; font-weight: 700; margin-bottom: 14px; color: var(--primary); }

    /* ── Filtri ── */
    .filtri-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; }
    .filtri-row label { font-size: 12px; color: var(--muted); display: block; margin-bottom: 4px; }
    .filtri-row input, .filtri-row select {
      background: var(--surface2); border: 1px solid rgba(255,255,255,.12);
      color: var(--text); border-radius: 7px; padding: 8px 12px; font-size: 14px;
    }
    .filtri-row .f-nome { flex: 1; min-width: 180px; }
    .btn-cerca {
      background: var(--primary); color: white; border: none; border-radius: 7px;
      padding: 9px 18px; font-size: 14px; font-weight: 700; cursor: pointer;
    }
    .btn-cerca:hover { opacity: .85; }

    /* ── Lista risultati ── */
    #risultati { display: flex; flex-direction: column; gap: 6px; max-height: 380px; overflow-y: auto; }
    .res-item {
      display: flex; align-items: center; gap: 10px; padding: 9px 12px;
      background: var(--surface2); border-radius: 7px; cursor: pointer;
      border: 1px solid transparent; transition: border .12s;
    }
    .res-item:hover { border-color: rgba(0,180,204,.4); }
    .res-item input[type=checkbox] { width: 17px; height: 17px; cursor: pointer; accent-color: var(--primary); }
    .res-nome { font-size: 13px; font-weight: 600; flex: 1; }
    .res-prog { font-size: 11px; color: var(--muted); font-family: monospace; }
    .stato-badge {
      font-size: 10px; padding: 2px 8px; border-radius: 10px; font-weight: 700;
    }
    .stato-na   { background: rgba(52,152,219,.25); color: #3498db; }
    .stato-ap   { background: rgba(22,160,133,.25); color: #1abc9c; }
    .stato-ch   { background: rgba(127,140,141,.2); color: #7f8c8d; }

    .sel-bar { display: flex; gap: 10px; align-items: center; font-size: 13px; color: var(--muted); margin-top: 10px; }
    .sel-bar button { background: none; border: 1px solid rgba(255,255,255,.2); color: var(--text); border-radius: 5px; padding: 4px 10px; font-size: 12px; cursor: pointer; }

    .spinner { width: 28px; height: 28px; border: 3px solid rgba(255,255,255,.15); border-top-color: var(--primary); border-radius: 50%; animation: spin .7s linear infinite; margin: 20px auto; }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── Opzioni etichetta ── */
    .opt-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; }
    .opt-cell { display: flex; flex-direction: column; gap: 4px; }
    .opt-cell label { font-size: 12px; color: var(--muted); }
    .opt-cell select, .opt-cell input {
      background: var(--surface2); border: 1px solid rgba(255,255,255,.12);
      color: var(--text); border-radius: 7px; padding: 7px 10px; font-size: 13px;
    }
    .opt-cell input[type=checkbox] { width: 18px; height: 18px; accent-color: var(--primary); cursor: pointer; margin-top: 4px; }

    /* ── Bottone genera ── */
    .btn-genera {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      background: var(--primary); color: white; border: none; border-radius: 10px;
      padding: 14px 24px; font-size: 16px; font-weight: 800; cursor: pointer; width: 100%;
    }
    .btn-genera:hover { opacity: .88; }
    .btn-genera:disabled { opacity: .4; cursor: default; }

    /* ── Preview stampa ── */
    #previewSection { display: none; }

    /* Foglio di stampa (solo per @media print) */
    #printSheet {
      display: flex; flex-wrap: wrap;
      gap: var(--gap, 4mm);
      padding: var(--pad, 8mm);
    }

    /* Etichetta singola */
    .etichetta {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      border: 1px dashed rgba(255,255,255,.15); border-radius: 6px;
      padding: 6px; background: white; color: #111;
      width: var(--w, 60mm); height: var(--h, 40mm);
      page-break-inside: avoid; break-inside: avoid;
      text-align: center; position: relative;
    }
    .etichetta .eqr { display: flex; align-items: center; justify-content: center; }
    .etichetta .etexts { display: flex; flex-direction: column; align-items: center; gap: 1px; margin-top: 3px; width: 100%; }
    .etichetta .enome { font-size: 7pt; font-weight: 700; line-height: 1.2; max-width: 100%; overflow: hidden; word-break: break-word; }
    .etichetta .eprog { font-size: 6.5pt; font-family: monospace; color: #444; }
    .etichetta .elotto { font-size: 6pt; color: #666; }

    /* Preview nel browser (dark theme) */
    .preview-wrap {
      background: #1e1e2e; border-radius: 10px; padding: 16px; overflow: auto; max-height: 520px;
    }
    #printSheet .etichetta {
      background: white; color: #111; border-color: #aaa;
    }

    .btn-stampa {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      background: #27ae60; color: white; border: none; border-radius: 10px;
      padding: 13px 22px; font-size: 15px; font-weight: 700; cursor: pointer;
    }
    .btn-stampa:hover { background: #1e8449; }

    .info-count { font-size: 13px; color: var(--muted); text-align: center; margin-bottom: 12px; }

    /* ── Auth wall ── */
    #authWall { display: none; flex: 1; align-items: center; justify-content: center; flex-direction: column; gap: 12px; padding: 60px 30px; text-align: center; }
    #authWall h2 { font-size: 20px; }
    #authWall p { color: var(--muted); font-size: 14px; }
    #authWall a { color: var(--primary); text-decoration: none; font-weight: 700; }

    /* ── Print styles ── */
    @media print {
      body { background: white !important; color: black !important; }
      .header, .container > .card:not(#printCard) { display: none !important; }
      #previewSection { display: block !important; }
      .preview-wrap { background: none; padding: 0; max-height: none; overflow: visible; }
      #printSheet { display: flex !important; }
      .btn-stampa, .info-count, h2 { display: none !important; }
      .etichetta { border: 1px dashed #bbb !important; background: white !important; color: #000 !important; }
    }
  </style>
</head>
<body>

<div class="header">
  <h1>🏷️ Generatore Etichette QR</h1>
  <a href="/">← Magazzino</a>
</div>

<div id="authWall">
  <h2>🔒 Accesso richiesto</h2>
  <p>Devi essere loggato per generare le etichette.</p>
  <a href="/login.html">Vai al login</a>
</div>

<div class="container" id="mainContent" style="display:none;">

  <!-- 1. Cerca reagenti -->
  <div class="card">
    <h2>1. Cerca e seleziona le bottiglie</h2>
    <div class="filtri-row">
      <div class="f-nome">
        <label>Nome prodotto (o parte)</label>
        <input type="text" id="cercaNome" placeholder="es: acetone, etanolo, 64-17-5…" style="width:100%;">
      </div>
      <div>
        <label>Stato</label>
        <select id="cercaStato">
          <option value="">Tutti</option>
          <option value="non_aperto">Non aperte</option>
          <option value="aperto">Aperte</option>
          <option value="chiuso">Chiuse</option>
        </select>
      </div>
      <div>
        <button class="btn-cerca" onclick="cercaReagenti()">🔍 Cerca</button>
      </div>
    </div>

    <div id="risultati" style="margin-top:14px;"></div>
    <div class="sel-bar" id="selBar" style="display:none;">
      <span id="selCount">0 selezionati</span>
      <button onclick="selTutti()">Tutti</button>
      <button onclick="deselTutti()">Nessuno</button>
    </div>
  </div>

  <!-- 2. Opzioni etichetta -->
  <div class="card">
    <h2>2. Formato etichetta</h2>
    <div class="opt-grid">
      <div class="opt-cell">
        <label>Larghezza etichetta</label>
        <select id="optW">
          <option value="40mm">40 mm</option>
          <option value="50mm">50 mm</option>
          <option value="60mm" selected>60 mm</option>
          <option value="80mm">80 mm</option>
        </select>
      </div>
      <div class="opt-cell">
        <label>Altezza etichetta</label>
        <select id="optH">
          <option value="25mm">25 mm</option>
          <option value="30mm">30 mm</option>
          <option value="40mm" selected>40 mm</option>
          <option value="50mm">50 mm</option>
        </select>
      </div>
      <div class="opt-cell">
        <label>Dim. QR code (px)</label>
        <select id="optQR">
          <option value="80">80 px</option>
          <option value="100" selected>100 px</option>
          <option value="120">120 px</option>
        </select>
      </div>
      <div class="opt-cell">
        <label>Mostra nome prodotto</label>
        <input type="checkbox" id="optNome" checked>
      </div>
      <div class="opt-cell">
        <label>Mostra progressivo</label>
        <input type="checkbox" id="optProg" checked>
      </div>
      <div class="opt-cell">
        <label>Mostra lotto</label>
        <input type="checkbox" id="optLotto">
      </div>
    </div>
  </div>

  <!-- 3. Genera -->
  <button class="btn-genera" id="btnGenera" onclick="generaEtichette()" disabled>
    🏷️ Genera etichette
  </button>

  <!-- Preview + Stampa -->
  <div id="previewSection" class="card" id="printCard" style="margin-top:20px;">
    <h2>3. Anteprima e stampa</h2>
    <div class="info-count" id="infoCount"></div>
    <div class="preview-wrap">
      <div id="printSheet"></div>
    </div>
    <br>
    <button class="btn-stampa" onclick="window.print()">🖨️ Stampa / Salva PDF</button>
  </div>

</div>

<script>
const BASE_URL = window.location.origin;
const SCAN_URL = BASE_URL + '/scan';

// ─── Auth ─────────────────────────────────────────────────────────────────────
function getToken() {
  try {
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      if (key && key.includes('-auth-token')) {
        const raw = localStorage.getItem(key);
        const s = JSON.parse(raw);
        return s?.access_token || s?.[0]?.access_token || null;
      }
    }
  } catch(e) {}
  return null;
}
function authH() {
  const t = getToken();
  return { 'Content-Type':'application/json', ...(t ? { Authorization:'Bearer '+t } : {}) };
}

window.addEventListener('DOMContentLoaded', () => {
  const token = getToken();
  if (!token) {
    document.getElementById('authWall').style.display = 'flex';
  } else {
    document.getElementById('mainContent').style.display = 'block';
    document.getElementById('cercaNome').addEventListener('keydown', e => {
      if (e.key === 'Enter') cercaReagenti();
    });
  }
});

// ─── Cerca reagenti ───────────────────────────────────────────────────────────
let reagentiTrovati = [];

async function cercaReagenti() {
  const nome = document.getElementById('cercaNome').value.trim();
  const stato = document.getElementById('cercaStato').value;
  const el = document.getElementById('risultati');
  el.innerHTML = '<div class="spinner"></div>';
  document.getElementById('selBar').style.display = 'none';
  document.getElementById('btnGenera').disabled = true;

  try {
    let url = `/api/reagenti?limit=300`;
    if (nome) url += `&nome=${encodeURIComponent(nome)}`;

    const res = await fetch(url, { headers: authH() });
    if (!res.ok) throw new Error('Errore ricerca');
    let data = await res.json();

    // Filtra per stato localmente
    if (stato) {
      data = data.filter(r => {
        if (stato === 'chiuso')    return !!r.data_chiusura;
        if (stato === 'aperto')    return !!r.data_apertura && !r.data_chiusura;
        if (stato === 'non_aperto') return !r.data_apertura;
        return true;
      });
    }

    reagentiTrovati = data;
    renderRisultati(data);
  } catch(err) {
    el.innerHTML = `<div style="color:#e74c3c; font-size:13px;">${err.message}</div>`;
  }
}

function renderRisultati(data) {
  const el = document.getElementById('risultati');
  if (!data.length) { el.innerHTML = '<div style="color:rgba(255,255,255,.4); font-size:13px; padding:12px;">Nessun risultato.</div>'; return; }

  el.innerHTML = data.map((r, i) => {
    const ap  = !!r.data_apertura && !r.data_chiusura;
    const ch  = !!r.data_chiusura;
    const stato = ap ? 'ap' : ch ? 'ch' : 'na';
    const label = ap ? 'Aperta' : ch ? 'Chiusa' : 'Non aperta';
    return `<label class="res-item">
      <input type="checkbox" class="res-chk" data-idx="${i}" onchange="aggiornaSel()">
      <span class="res-nome">${escHtml(r.nome_prodotto)}</span>
      <span class="res-prog">${escHtml(r.progressivo)}</span>
      <span class="stato-badge stato-${stato}">${label}</span>
    </label>`;
  }).join('');

  document.getElementById('selBar').style.display = 'flex';
  aggiornaSel();
}

function aggiornaSel() {
  const checked = document.querySelectorAll('.res-chk:checked').length;
  document.getElementById('selCount').textContent = `${checked} selezionat${checked===1?'a':'e'}`;
  document.getElementById('btnGenera').disabled = checked === 0;
}
function selTutti()   { document.querySelectorAll('.res-chk').forEach(c => c.checked = true);  aggiornaSel(); }
function deselTutti() { document.querySelectorAll('.res-chk').forEach(c => c.checked = false); aggiornaSel(); }

// ─── Genera etichette ─────────────────────────────────────────────────────────
function generaEtichette() {
  const selIdx = [...document.querySelectorAll('.res-chk:checked')].map(c => parseInt(c.dataset.idx));
  if (!selIdx.length) return;

  const w     = document.getElementById('optW').value;
  const h     = document.getElementById('optH').value;
  const qrPx  = parseInt(document.getElementById('optQR').value);
  const mostraNome  = document.getElementById('optNome').checked;
  const mostraProg  = document.getElementById('optProg').checked;
  const mostraLotto = document.getElementById('optLotto').checked;

  const sheet = document.getElementById('printSheet');
  sheet.style.setProperty('--w', w);
  sheet.style.setProperty('--h', h);
  sheet.innerHTML = '';

  selIdx.forEach(idx => {
    const r = reagentiTrovati[idx];
    const url = `${SCAN_URL}?p=${encodeURIComponent(r.progressivo)}`;

    // Contenitore etichetta
    const div = document.createElement('div');
    div.className = 'etichetta';

    // QR code
    const qrDiv = document.createElement('div');
    qrDiv.className = 'eqr';
    div.appendChild(qrDiv);

    new QRCode(qrDiv, {
      text: url,
      width: qrPx,
      height: qrPx,
      colorDark: '#000000',
      colorLight: '#ffffff',
      correctLevel: QRCode.CorrectLevel.M
    });

    // Testi
    const texts = document.createElement('div');
    texts.className = 'etexts';

    if (mostraNome) {
      const nome = document.createElement('div');
      nome.className = 'enome';
      // Tronca il nome a 50 caratteri per non sovraffollare
      nome.textContent = r.nome_prodotto.length > 50
        ? r.nome_prodotto.substring(0,47) + '…'
        : r.nome_prodotto;
      texts.appendChild(nome);
    }

    if (mostraProg) {
      const prog = document.createElement('div');
      prog.className = 'eprog';
      prog.textContent = r.progressivo;
      texts.appendChild(prog);
    }

    if (mostraLotto && r.lotto) {
      const lot = document.createElement('div');
      lot.className = 'elotto';
      lot.textContent = 'Lotto: ' + r.lotto;
      texts.appendChild(lot);
    }

    div.appendChild(texts);
    sheet.appendChild(div);
  });

  document.getElementById('infoCount').textContent =
    `${selIdx.length} etichett${selIdx.length===1?'a':'e'} pronte — clicca "Stampa / Salva PDF" per procedere`;

  const preview = document.getElementById('previewSection');
  preview.style.display = 'block';
  preview.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function escHtml(s) {
  return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
</script>
</body>
</html>
